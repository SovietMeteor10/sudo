{
  "name": "sudo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node dist/server.js",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev:reset": "npm run build && node dist/cli/devReset.js",
    "create-user": "npm run build && node dist/cli/createUser.js",
    "check:env": "npm run build && node dist/cli/checkEnv.js",
    "smoke": "bash scripts/smoke.sh",
    "smoke:auth": "node scripts/test-register.cjs",
    "smoke:auth-flow": "node scripts/auth-smoke.cjs",
    "smoke:auth-lifecycle": "node scripts/auth-lifecycle-smoke.cjs",
    "backup:sqlite": "bash scripts/backup-sqlite.sh"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.6",
    "better-sqlite3": "^11.9.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3"
  }
}
